APP_NAME=Witty-Accounting

DB_HOST=db
DB_PORT=3306
DB_NAME=witty_accounting

DB_USER=witty
DB_PASSWORD=changeme

SECRET_KEY=CHANGE_ME

LOG_LEVEL=INFO

JWT_SECRET_KEY=

FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

INVOICE_ISSUER_NAME=
INVOICE_ISSUER_ADDRESS=
INVOICE_TAX_NUMBER=
INVOICE_VAT_ID=
INVOICE_PAYMENT_TERM_DAYS=0

INVOICE_PDF_ARCHIVE_DIR=data/invoices

GHOSTSCRIPT_EXECUTABLE=gs
PDFA_ICC_PROFILE_PATH=/usr/share/color/icc/ghostscript/srgb.icc
PDFA_CONVERSION_TIMEOUT_SECONDS=30

SMTP_HOST=host.docker.internal
SMTP_PORT=25
SMTP_TIMEOUT_SECONDS=10
SMTP_STARTTLS=false

MAIL_FROM_ADDRESS=rechnung@example.de
MAIL_FROM_NAME=Beispielunternehmen

MAIL_SMIME_ENABLED=false
# MAIL_SMIME_PKCS12_PATH=/run/secrets/invoice-mail-signing.p12
# MAIL_SMIME_PKCS12_PASSWORD_FILE=/run/secrets/invoice-mail-signing-password
