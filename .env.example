# Name of the app
APP_NAME=Witty-Accounting

# DB container name, port and DB name for Witty
DB_HOST=db
DB_PORT=3306
DB_NAME=witty_accounting

# DB user and passoword, DB Root User Passoword
DB_USER=witty
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=replace-with-a-different-password

# Multi-tenant mode remains disabled until the control database has
# been created and the first tenant has been registered.
TENANCY_ENABLED=false
# CONTROL_DB_HOST=db
# CONTROL_DB_PORT=3306
# CONTROL_DB_NAME=witty_control
# CONTROL_DB_USER=witty_control
# CONTROL_DB_PASSWORD=replace-with-a-control-db-password
# TENANT_DB_ENCRYPTION_KEY=replace-with-a-fernet-key
# TENANT_REGISTRY_CACHE_SECONDS=30
# TENANT_ENGINE_CACHE_SIZE=20

# UID/GID for the app container
WITTY_UID=1000
WITTY_GID=1000

# data directory on the host
WITTY_DATA_DIR=/srv/witty

# Listen address and port
WITTY_BIND_ADDRESS=0.0.0.0
WITTY_PORT=8000

# Archive directory for invoices 
# Please provide a volume for permanent storage
INVOICE_PDF_ARCHIVE_DIR=data/invoices

# app lo level
LOG_LEVEL=INFO

# encryption keys.
JWT_SECRET_KEY=secret-encryption-key 
SMTP_SETTINGS_ENCRYPTION_KEY=secret-encrypton-key-for-smtp-settings
